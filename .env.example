# Flex robot under test (KansasFLEX). Lab DHCP has moved between .20 and .21.
ROBOT_HOST=192.168.0.21
# Comma-separated fallbacks probed via GET /health when ROBOT_HOST is stale.
ROBOT_HOST_CANDIDATES=192.168.0.21,192.168.0.20
ROBOT_NAME=KansasFLEX

# Local read-only reference clones (do not modify from this harness)
OPENTRONS_REPO_PATH=./upstream/opentrons
ROBOT_STACK_REPO_PATH=./upstream/robot-stack

# HTTP ports (prior art defaults)
ROBOT_HTTP_PORT=31950
ROBOT_HTTPS_PORT=32313
# Use https when CA trust is configured (see flex-test crs trust-ca).
ROBOT_USE_HTTPS=false
# ROBOT_CERTS_DIR=./artifacts/robot-certs
# ROBOT_CA_PEM=/path/to/robot-ca.pem
# CRS service PIN override for enter/disable CRS (NOT for HTTPS trust-ca)
# CRS_SERVICE_PASSWORD=

# CRS-on user provisioning (passwords in .env only; not committed)
# CRS_FIXTURE_PASSWORD=
# CRS_ADMIN_USERNAME=
# CRS_ADMIN_PASSWORD=
# Per-user overrides: CRS_PASSWORD_FLEX_TEST_ADMIN, etc.

# Timeouts
ROBOT_REQUEST_TIMEOUT_SECONDS=30
ROBOT_HEALTH_TIMEOUT_SECONDS=10

# Persistence and artifacts
DATABASE_URL=sqlite+aiosqlite:///./artifacts/flex_testing.db
ARTIFACT_DIRECTORY=./artifacts
LOG_LEVEL=INFO

# Safety: mutations off by default. Do not enable access control via this harness.
ALLOW_MUTATIONS=false
DRY_RUN=false

# Optional credentials for future access-control-on testing (not required when AC is off).
# ROBOT_USERNAME=
# ROBOT_PASSWORD=
# CRS-on mutating requests require Opentrons-User-Notes (audit trail). Empty disables.
# ROBOT_USER_NOTES=flex-testing-agent CRS-on probe
# Throwaway user-management API tests (flex-test crs users-api):
# CRS_UM_TEST_PASSWORD=FlexHarnessUm1!

# FTDI USB serial console (see docs/serial-console.md). Empty SERIAL_PORT = auto-detect.
# SERIAL_PORT=/dev/cu.usbserial-ABAKGEZI
SERIAL_BAUD_RATE=115200
